[Unit]
Description=Process Aquarium eBPF collection agent
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/home/ubuntu/process-aquarium
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/default/process-aquarium-agent
ExecStart=/home/ubuntu/process-aquarium/tools/start-ebpf-agent.sh
Restart=always
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
